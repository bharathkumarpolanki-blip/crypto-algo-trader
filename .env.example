# Exchange API Keys (Coinbase Advanced Trade)
# Get keys at: https://www.coinbase.com/settings/api
# Required permissions: View + Trade (do NOT enable Transfer)
EXCHANGE=coinbase
API_KEY=your_coinbase_api_key_here
API_SECRET=your_coinbase_api_secret_here

# Coinbase does not have a public testnet.
# Set DRY_RUN=true in config.py (the default) to paper-trade safely.
TESTNET=false

# Capital Management (USD — Coinbase trades USD, not USDT)
TOTAL_CAPITAL_USDT=1000
MAX_OPEN_POSITIONS=5
RISK_PER_TRADE_PCT=2.0       # % of capital risked per trade
MAX_PORTFOLIO_RISK_PCT=10.0  # Max total portfolio risk at once

# Sentiment — no API keys needed!
# Uses Alternative.me Fear & Greed Index + CoinGecko + RSS feeds (all free, no signup)

# Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=INFO

# ── TradingView webhook bot (tradingview_bot.py) ──────────────────────────────
# Shared secret embedded in every TradingView alert's JSON ({"passphrase":"..."}).
# REQUIRED before live trading is armed. Use a long random string.
WEBHOOK_PASSPHRASE=wearedoingit
# Server bind (TradingView itself only posts to a PUBLIC url on port 80/443 —
# expose this port via a tunnel/reverse proxy; see WEBHOOK.md).
WEBHOOK_PORT=8090
WEBHOOK_PATH=/webhook
# Live-trading arm switch. Real orders need this True AND DRY_RUN=false AND a
# passphrase AND a valid API key. Leave false to paper-trade.
WEBHOOK_LIVE_ENABLED=false
# Optional: restrict to TradingView's source IPs (leave false behind a tunnel).
WEBHOOK_IP_ALLOWLIST=false
# Paper portfolio + sizing
WEBHOOK_START_CAPITAL_USD=1000
WEBHOOK_DEFAULT_ORDER_USD=100   # used when an alert omits a size
WEBHOOK_MAX_ORDER_USD=500       # hard per-trade cap
WEBHOOK_MAX_OPEN_POSITIONS=10
WEBHOOK_MAX_DAILY_LOSS_USD=0    # 0 = off; halts new entries after this realized daily loss